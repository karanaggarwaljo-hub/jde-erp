NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose to the browser — it's what lets a signed-in visitor's own
# browser session talk to Supabase Auth directly. Find it in your Supabase
# project dashboard under Project Settings -> API (either the legacy "anon
# public" key or the newer "publishable" key both work).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional but recommended once deployed. The fixed address password-reset and invite emails
# link back to. Without it, that link is built from the incoming request's own host, which is
# fine for local dev but not something to rely on in production. Set to your real address with
# no trailing slash, e.g. https://erp.jd-enterprise.com
# NEXT_PUBLIC_SITE_URL=

# Server-only — never expose this to the browser. Find it in your Supabase
# project dashboard under Project Settings -> API -> service_role secret.
# This is what lets the app read/write data; without it, every page will be empty.
SUPABASE_SERVICE_ROLE_KEY=

# Preferred replacement for the legacy service-role key. The read-only ERP integration accepts
# either this newer server-only secret or SUPABASE_SERVICE_ROLE_KEY; never prefix it NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Server-to-server read integration for the Adaptive Skill Platform. Generate at least 32 random
# characters and place the same value in that platform's ERP_ADAPTER_TOKEN. This route is disabled
# until a valid token is configured. Every company in jde_companies, including companies created
# after deployment, is available automatically; every data query remains company-scoped.
ERP_INTEGRATION_TOKEN=
# Optional previous token for zero-downtime rotation; remove after all callers use the new token.
# ERP_INTEGRATION_PREVIOUS_TOKEN=
# This ERP has no warehouse table today, so all audited stock is exposed through one explicit
# virtual warehouse. The adaptive platform must send this exact value.
ERP_INTEGRATION_WAREHOUSE_ID=default
ERP_INTEGRATION_UNIT_OF_MEASURE=EA

# Automatic Adaptive Skill Platform tenant onboarding. The same 32+ character secret is set on
# the platform as ERP_COMPANY_EVENT_SECRET. CRON_SECRET protects the daily outbox reconciliation.
ADAPTIVE_PLATFORM_BASE_URL=
ERP_COMPANY_EVENT_SECRET=
# CRON_SECRET now guards both scheduled jobs in vercel.json: the outbox reconciliation above and
# the nightly database backup (/api/cron/backup). Vercel sends it as "Authorization: Bearer
# <CRON_SECRET>" on every scheduled call, and both routes accept nothing else. Must be at least
# 32 characters — a shorter value is ignored, leaving both jobs refusing to run rather than
# running on a weak secret. Left unset, the backup does not run at all; that is deliberate, since
# that route reads every table, so it fails closed rather than open. Not needed for local dev,
# where "Backup Now" in Settings -> Data Backups does the same job on demand.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Required for the AI Business Insights / Forecast features.
# Gemini has a free tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model (gemini-3.6-flash). You should not need to.
# The default is pinned on purpose and is NOT Google's "gemini-flash-latest" alias: that alias
# always points at the newest flash model, which carries the smallest free-tier allowance (as
# little as 20 requests a day) and is the most contended — it returns 503 "experiencing high
# demand" under load while pinned versions of the same family answer normally. A moving alias
# also lets the app's behaviour change with no deploy. List the models your key can reach with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-3.6-flash
# Optional: override the default image model (gemini-2.5-flash-image), used
# only by Website Catalog's "Generate with AI" product photo feature.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Fallback AI provider. Optional but strongly recommended: when Gemini is rate-limited
# or down (it returns "high demand" errors under load), every AI feature that can fall
# back automatically retries here instead of showing an error.
# Free tier, no card needed — key from https://console.groq.com -> API Keys.
GROQ_API_KEY=

# Third AI provider, so that one service running out of free allowance can't take every AI
# feature down with it. Free tier at https://cloud.cerebras.ai — no card required. Text only:
# it is never sent invoice photos, which stay with Gemini and Groq.
CEREBRAS_API_KEY=
# Optional: override the default model (gpt-oss-120b). The other public model is qwen-3.8-27b.
# CEREBRAS_MODEL=gpt-oss-120b
# Optional: override the defaults. The vision model is used only for scanning invoices.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: which providers to try, in order, for analysis and document work.
# Default is "gemini,groq". Unconfigured providers are skipped automatically.
# AI_PROVIDER_ORDER=gemini,groq
# Optional: the order used for short interactive asks (expense category, part details,
# reminder drafts), where answering in under a second matters more than the better model.
# AI_FAST_ORDER=groq,gemini

# Optional: how long the leading provider works alone before the next one is started
# *alongside* it, with the first valid answer winning. This is what stops one slow service
# from holding up a request. Doubled automatically when a document is attached.
# Set to 0 to disable and fall back to plain one-after-the-other retries.
# AI_HEDGE_MS=4000
# AI_FAST_HEDGE_MS=2000

# Optional: hard ceiling on a single AI call before it is abandoned.
# Default is 14s for text, 30s when a document is attached.
# AI_TIMEOUT_MS=14000

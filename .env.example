NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose to the browser — it's what lets a signed-in visitor's own
# browser session talk to Supabase Auth directly. Find it in your Supabase
# project dashboard under Project Settings -> API (either the legacy "anon
# public" key or the newer "publishable" key both work).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional but recommended once deployed. The fixed address password-reset and invite emails
# link back to. Without it, that link is built from the incoming request's own host, which is
# fine for local dev but not something to rely on in production. Set to your real address with
# no trailing slash, e.g. https://erp.jd-enterprise.com
# NEXT_PUBLIC_SITE_URL=

# Server-only — never expose this to the browser. Find it in your Supabase
# project dashboard under Project Settings -> API -> service_role secret.
# This is what lets the app read/write data; without it, every page will be empty.
SUPABASE_SERVICE_ROLE_KEY=

# Required for the AI Business Insights / Forecast features.
# Gemini has a free tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model (gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
# Optional: override the default image model (gemini-2.5-flash-image), used
# only by Website Catalog's "Generate with AI" product photo feature.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Fallback AI provider. Optional but strongly recommended: when Gemini is rate-limited
# or down (it returns "high demand" errors under load), every AI feature that can fall
# back automatically retries here instead of showing an error.
# Free tier, no card needed — key from https://console.groq.com -> API Keys.
GROQ_API_KEY=
# Optional: override the defaults. The vision model is used only for scanning invoices.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: which providers to try, in order. Default is "gemini,groq".
# Unconfigured providers are skipped automatically.
# AI_PROVIDER_ORDER=gemini,groq
# Optional: how long to wait on one AI call before trying the next provider.
# Default is 25s for text, 45s when a document is attached.
# AI_TIMEOUT_MS=25000
